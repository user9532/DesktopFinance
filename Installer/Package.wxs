<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <!--
    DesktopFinance installer.

    UpgradeCode must NEVER change once you have shipped a release — it is the
    stable identity WiX/MSI uses to recognize "this is the same product, a
    different version" and drive the MajorUpgrade (remove-old/install-new)
    behavior below. ProductVersion (see DesktopFinanceSetup.wixproj) is what
    you bump for every release.
  -->
  <Package Name="DesktopFinance"
            Manufacturer="eWorkpaper.com"
            Version="$(ProductVersion)"
            UpgradeCode="6E2F6D0C-6B36-4C8B-9E7E-6E2C6F6E9F10"
            Language="1033"
            Compressed="yes"
            InstallerVersion="500"
            Scope="perMachine">

    <SummaryInformation Description="DesktopFinance Setup" Manufacturer="eWorkpaper.com" />

    <!-- Refuse to install over a newer version already on the machine, and
         automatically remove the previous version before installing this one. -->
    <MajorUpgrade
      DowngradeErrorMessage="A newer version of DesktopFinance is already installed. Setup will now exit." />

    <MediaTemplate EmbedCab="yes" />

    <!-- ── Directory layout ────────────────────────────────────────────── -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="DesktopFinance" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="DesktopFinance" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <!-- ── Application files ───────────────────────────────────────────
         Pulls in every file produced by:
             dotnet publish -c Release -r win-x64 -\-self-contained true
         (the whole self-contained payload: Finance.exe, managed DLLs,
         the .NET 8 runtime files, and the native SQLite e_sqlite3.dll).
         Files auto-generates one Component per file, so nothing here needs
         to be hand-maintained when the app's dependency set changes.

         Per-locale *.resources.dll satellite subfolders (cs\, de\, fr\, ...)
         are excluded: they only carry non-English UI strings for the .NET/WPF
         framework assemblies, the app runs fine in English without them, and
         several locales ship an identically-named file which <Files> cannot
         auto-dedupe (WIX8602). Remove the exclude below if you need them. -->
    <ComponentGroup Id="ApplicationFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.PublishDir)**">
        <Exclude Files="$(var.PublishDir)**\*.pdb" />
        <Exclude Files="$(var.PublishDir)cs\**" />
        <Exclude Files="$(var.PublishDir)de\**" />
        <Exclude Files="$(var.PublishDir)es\**" />
        <Exclude Files="$(var.PublishDir)fr\**" />
        <Exclude Files="$(var.PublishDir)it\**" />
        <Exclude Files="$(var.PublishDir)ja\**" />
        <Exclude Files="$(var.PublishDir)ko\**" />
        <Exclude Files="$(var.PublishDir)pl\**" />
        <Exclude Files="$(var.PublishDir)pt-BR\**" />
        <Exclude Files="$(var.PublishDir)ru\**" />
        <Exclude Files="$(var.PublishDir)tr\**" />
        <Exclude Files="$(var.PublishDir)zh-Hans\**" />
        <Exclude Files="$(var.PublishDir)zh-Hant\**" />
      </Files>
    </ComponentGroup>

    <!-- ── Shortcuts ───────────────────────────────────────────────────── -->
    <Component Id="ApplicationShortcuts" Directory="ApplicationProgramsFolder" Guid="9C2E1E2E-2C3B-4A0C-9E3E-1B7E7C2E4A11">
      <Shortcut Id="StartMenuShortcut"
                Name="DesktopFinance"
                Description="Personal finance manager"
                Target="[INSTALLFOLDER]Finance.exe"
                WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
      <RegistryValue Root="HKCU"
                      Key="Software\DesktopFinance"
                      Name="StartMenuShortcutInstalled"
                      Type="integer"
                      Value="1"
                      KeyPath="yes" />
    </Component>

    <Component Id="DesktopShortcut" Directory="DesktopFolder" Guid="4B7B9F2C-9A9B-4E9D-8B3E-2E9A9F4B7C22">
      <Shortcut Id="DesktopShortcut"
                Name="DesktopFinance"
                Description="Personal finance manager"
                Target="[INSTALLFOLDER]Finance.exe"
                WorkingDirectory="INSTALLFOLDER" />
      <RegistryValue Root="HKCU"
                      Key="Software\DesktopFinance"
                      Name="DesktopShortcutInstalled"
                      Type="integer"
                      Value="1"
                      KeyPath="yes" />
    </Component>

    <!-- ── Feature tree ────────────────────────────────────────────────── -->
    <Feature Id="MainApplication" Title="DesktopFinance" Level="1">
      <ComponentGroupRef Id="ApplicationFiles" />
      <ComponentRef Id="ApplicationShortcuts" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

    <!-- Standard install-directory/license/progress/finish UI.
         License.rtf is a placeholder — replace its text with your real
         license terms before distributing this installer. -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />

  </Package>
</Wix>
