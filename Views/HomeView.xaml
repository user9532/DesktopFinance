<UserControl x:Class="FinanceApp.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">

            <!-- ── Pending Transactions panel ─────────────────────────────── -->
            <Border Background="#EAF5F5"
                    BorderBrush="#B8DEDE"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="14"
                    Margin="0,0,0,16">
                <DockPanel>

                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Pending Transactions (overdue and due in the next 30 days)"
                                   FontSize="15" FontWeight="Bold" Foreground="#1F6E6E" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="View" Padding="10,3"
                                Click="ViewRecurring_Click"/>
                    </Grid>

                    <StackPanel>

                        <!-- Pending Payments -->
                        <TextBlock Text="Pending Payments"
                                   FontSize="13" FontWeight="SemiBold"
                                   Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Vendor" FontWeight="SemiBold" Margin="12,0,0,0"/>
                            <TextBlock Grid.Column="1" Text="Amount" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="2" Text="Date"   FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,0,4,0"/>
                        </Grid>
                        <Separator Margin="0,0,0,4"/>
                        <ItemsControl x:Name="PendingPaymentsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="110"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Payee}" Margin="12,0,0,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding AmountDisplay}"
                                                   HorizontalAlignment="Right"/>
                                        <TextBlock Grid.Column="2" Text="{Binding NextDue}"
                                                   HorizontalAlignment="Right" Margin="0,0,4,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="TxtNoPayments" Text="No payments due in the next 30 days."
                                   Foreground="#888888" Margin="12,2,0,0" Visibility="Collapsed"/>

                        <!-- Thick separator between Pending Payments and Pending Receipts -->
                        <Border BorderBrush="#999999" BorderThickness="0,2,0,0" Margin="0,16,0,10"/>

                        <!-- Pending Receipts -->
                        <TextBlock Text="Pending Receipts"
                                   FontSize="13" FontWeight="SemiBold"
                                   Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Vendor" FontWeight="SemiBold" Margin="12,0,0,0"/>
                            <TextBlock Grid.Column="1" Text="Amount" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="2" Text="Date"   FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,0,4,0"/>
                        </Grid>
                        <Separator Margin="0,0,0,4"/>
                        <ItemsControl x:Name="PendingReceiptsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="110"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Payee}" Margin="12,0,0,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding AmountDisplay}"
                                                   HorizontalAlignment="Right"/>
                                        <TextBlock Grid.Column="2" Text="{Binding NextDue}"
                                                   HorizontalAlignment="Right" Margin="0,0,4,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="TxtNoReceipts" Text="No receipts due in the next 30 days."
                                   Foreground="#888888" Margin="12,2,0,0" Visibility="Collapsed"/>

                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ── Bank / Credit Card balance panels ──────────────────────── -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Bank accounts -->
                <Border Grid.Column="0"
                        Background="#EAF2FB"
                        BorderBrush="#BBD3EF"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14">
                    <StackPanel>
                        <TextBlock Text="Bank Accounts"
                                   FontSize="15" FontWeight="Bold"
                                   Foreground="#1F5C99"
                                   Margin="0,0,0,10"/>
                        <ItemsControl x:Name="BankBalanceList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="110"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Name}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding BalanceDisplay}"
                                                   HorizontalAlignment="Right"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="TxtNoBankAccounts" Text="No bank accounts found."
                                   Foreground="#888888" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <!-- Credit card accounts -->
                <Border Grid.Column="2"
                        Background="#FBEAEA"
                        BorderBrush="#EFBBBB"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14">
                    <StackPanel>
                        <TextBlock Text="Credit Card Accounts"
                                   FontSize="15" FontWeight="Bold"
                                   Foreground="#A03030"
                                   Margin="0,0,0,10"/>
                        <ItemsControl x:Name="CreditCardBalanceList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="110"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Name}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding BalanceDisplay}"
                                                   HorizontalAlignment="Right"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="TxtNoCreditCards" Text="No credit card accounts found."
                                   Foreground="#888888" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ── Investment / Loan balance panels ───────────────────────── -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Investment accounts -->
                <Border Grid.Column="0"
                        Background="#EAF7EE"
                        BorderBrush="#BEE3C6"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14">
                    <StackPanel>
                        <TextBlock Text="Investment Accounts"
                                   FontSize="15" FontWeight="Bold"
                                   Foreground="#227A3E"
                                   Margin="0,0,0,10"/>
                        <ItemsControl x:Name="InvestmentBalanceList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="110"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Name}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding BalanceDisplay}"
                                                   HorizontalAlignment="Right"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="TxtNoInvestmentAccounts" Text="No investment accounts found."
                                   Foreground="#888888" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <!-- Loan accounts -->
                <Border Grid.Column="2"
                        Background="#F1EAFB"
                        BorderBrush="#D3BBEF"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14">
                    <StackPanel>
                        <TextBlock Text="Loan Accounts"
                                   FontSize="15" FontWeight="Bold"
                                   Foreground="#6B2FA0"
                                   Margin="0,0,0,10"/>
                        <ItemsControl x:Name="LoanBalanceList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="110"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Name}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding BalanceDisplay}"
                                                   HorizontalAlignment="Right"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="TxtNoLoanAccounts" Text="No loan accounts found."
                                   Foreground="#888888" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ── Dashboard: Budget vs Actual bar chart ──────────────────── -->
            <Border Background="#EEF0F7"
                    BorderBrush="#C9CEE0"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="14">
                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TxtDashboardTitle"
                                   Grid.Column="0"
                                   Text="Budget vs Actual Expense"
                                   FontSize="15" FontWeight="Bold"
                                   Foreground="#3B4470"
                                   VerticalAlignment="Center"/>
                        <ComboBox x:Name="CbDashboardMonth"
                                  Grid.Column="1"
                                  Width="130"
                                  SelectionChanged="CbDashboardMonth_SelectionChanged"/>
                    </Grid>
                    <TextBlock x:Name="TxtDashboardSubtitle"
                               Foreground="#666666"
                               Margin="0,0,0,10"/>

                    <!-- Legend -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Rectangle Width="12" Height="12" Fill="#4C78A8" Margin="0,0,4,0"/>
                        <TextBlock Text="Budget" Margin="0,0,16,0" VerticalAlignment="Center"/>
                        <Rectangle Width="12" Height="12" Fill="#E45756" Margin="0,0,4,0"/>
                        <TextBlock Text="Actual" VerticalAlignment="Center"/>
                    </StackPanel>

                    <ItemsControl x:Name="DashboardChart">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,5">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                                               Text="{Binding Category}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>

                                    <!-- Budget bar -->
                                    <Grid Grid.Row="0" Grid.Column="1" Margin="0,1">
                                        <Rectangle Height="18" HorizontalAlignment="Left"
                                                   Fill="#4C78A8"
                                                   Width="{Binding BudgetBarWidth}"/>
                                    </Grid>
                                    <TextBlock Grid.Row="0" Grid.Column="2"
                                               Text="{Binding BudgetDisplay}"
                                               FontSize="11" VerticalAlignment="Center"/>

                                    <!-- Actual bar -->
                                    <Grid Grid.Row="1" Grid.Column="1" Margin="0,1">
                                        <Rectangle Height="18" HorizontalAlignment="Left"
                                                   Fill="#E45756"
                                                   Width="{Binding ActualBarWidth}"/>
                                    </Grid>
                                    <TextBlock Grid.Row="1" Grid.Column="2"
                                               Text="{Binding ActualDisplay}"
                                               FontSize="11" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="TxtNoDashboardData"
                               Text="No budget or expense data available."
                               Foreground="#888888" Visibility="Collapsed"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
