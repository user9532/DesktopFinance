<UserControl x:Class="FinanceApp.Views.CashFlowView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,20,0,20" HorizontalAlignment="Center">

            <TextBlock Text="Statement of Cash Flows"
                       FontSize="16" FontWeight="Bold"
                       HorizontalAlignment="Center"/>
            <TextBlock x:Name="TxtPeriod"
                       FontSize="13"
                       HorizontalAlignment="Center"
                       Margin="0,4,0,18"/>

            <ItemsControl x:Name="RowsHost">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="{Binding RowMargin}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="300"/>
                                <ColumnDefinition Width="130"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Label}"
                                       Margin="{Binding LabelMargin}"
                                       FontWeight="{Binding Weight}"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding AmountDisplay}"
                                       FontWeight="{Binding Weight}"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
