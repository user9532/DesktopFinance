<UserControl x:Class="FinanceApp.Views.InvestmentStatementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DockPanel>

        <!-- ── toolbar ────────────────────────────────────────────────── -->
        <Border DockPanel.Dock="Top"
                Background="#F0F0F0"
                BorderBrush="#CCCCCC"
                BorderThickness="0,0,0,1"
                Padding="6,5">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Add Row" Width="88" Margin="0,0,6,0" Style="{StaticResource SecondaryButtonStyle}" Click="AddRow_Click"/>
                    <Button Content="Save"    Width="76" Margin="0,0,14,0" Click="Save_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Transaction" Width="90" Margin="0,0,8,0" Click="Transaction_Click"/>
                    <Button Content="Trade"       Width="70" Margin="0,0,8,0" Click="Trade_Click"/>
                    <Button Content="Portfolio"   Width="80" Click="Portfolio_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ── investment grid ────────────────────────────────────────── -->
        <DataGrid x:Name="TrGrid"
                  AutoGenerateColumns="False"
                  CanUserSortColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionUnit="FullRow"
                  GridLinesVisibility="Horizontal"
                  AlternatingRowBackground="#FAFAFA"
                  CellEditEnding="Grid_CellEditEnding"
                  PreviewMouseRightButtonDown="TrGrid_PreviewMouseRightButtonDown">

            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Delete…" Click="DeleteRow_Click"/>
                </ContextMenu>
            </DataGrid.ContextMenu>

            <DataGrid.Columns>

                <!-- Date -->
                <DataGridTemplateColumn Header="Date" Width="100" SortMemberPath="DateDisplay">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DateDisplay}" Margin="3,1"
                                       VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <DatePicker SelectedDate="{Binding DateValue, UpdateSourceTrigger=PropertyChanged}"
                                        Loaded="DatePicker_Loaded"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>

                <!-- Check No -->
                <DataGridTextColumn Header="Check No"
                                    Binding="{Binding CheckNo, UpdateSourceTrigger=PropertyChanged}"
                                    Width="76"/>

                <!-- Name -->
                <DataGridTextColumn Header="Name"
                                    Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                    Width="130"/>

                <!-- Category (ComboBox) -->
                <DataGridTemplateColumn Header="Category" Width="130">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayCategory}" Margin="3,1"
                                       VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox IsEditable="True"
                                      Text="{Binding DisplayCategory, UpdateSourceTrigger=PropertyChanged}"
                                      Loaded="CategoryCombo_Loaded"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>

                <!-- Memo -->
                <DataGridTextColumn Header="Memo"
                                    Binding="{Binding Memo, UpdateSourceTrigger=PropertyChanged}"
                                    Width="130"/>

                <!-- Action -->
                <DataGridTextColumn Header="Action"
                                    Binding="{Binding Action, UpdateSourceTrigger=PropertyChanged}"
                                    Width="64"/>

                <!-- Symbol -->
                <DataGridTextColumn Header="Symbol"
                                    Binding="{Binding Symbol, UpdateSourceTrigger=PropertyChanged}"
                                    Width="64"/>

                <!-- Quantity -->
                <DataGridTextColumn Header="Quantity" Width="80"
                                    Binding="{Binding Quantity, StringFormat=N4, UpdateSourceTrigger=PropertyChanged}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter Property="Margin" Value="0,0,4,0"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                    <DataGridTextColumn.EditingElementStyle>
                        <Style TargetType="TextBox">
                            <Setter Property="TextAlignment" Value="Right"/>
                        </Style>
                    </DataGridTextColumn.EditingElementStyle>
                </DataGridTextColumn>

                <!-- Price -->
                <DataGridTextColumn Header="Price" Width="80"
                                    Binding="{Binding Price, StringFormat=N4, UpdateSourceTrigger=PropertyChanged}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter Property="Margin" Value="0,0,4,0"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                    <DataGridTextColumn.EditingElementStyle>
                        <Style TargetType="TextBox">
                            <Setter Property="TextAlignment" Value="Right"/>
                        </Style>
                    </DataGridTextColumn.EditingElementStyle>
                </DataGridTextColumn>

                <!-- Commission -->
                <DataGridTextColumn Header="Commission" Width="84"
                                    Binding="{Binding Commission, StringFormat=N2, UpdateSourceTrigger=PropertyChanged}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter Property="Margin" Value="0,0,4,0"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                    <DataGridTextColumn.EditingElementStyle>
                        <Style TargetType="TextBox">
                            <Setter Property="TextAlignment" Value="Right"/>
                        </Style>
                    </DataGridTextColumn.EditingElementStyle>
                </DataGridTextColumn>

                <!-- Amount -->
                <DataGridTextColumn Header="Amount" Width="90"
                                    Binding="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter Property="Margin" Value="0,0,4,0"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                    <DataGridTextColumn.EditingElementStyle>
                        <Style TargetType="TextBox">
                            <Setter Property="TextAlignment" Value="Right"/>
                        </Style>
                    </DataGridTextColumn.EditingElementStyle>
                </DataGridTextColumn>

                <!-- Balance (read-only) -->
                <DataGridTextColumn Header="Balance" Width="90"
                                    Binding="{Binding Balance, StringFormat=N2}"
                                    IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter Property="Margin" Value="0,0,4,0"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
