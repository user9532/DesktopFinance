<UserControl x:Class="FinanceApp.Views.IncomeExpensesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DockPanel>

        <!-- ── Toolbar ───────────────────────────────────────────────────── -->
        <Border DockPanel.Dock="Top"
                Background="#F0F0F0"
                BorderBrush="#CCCCCC"
                BorderThickness="0,0,0,1"
                Padding="6,5">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Export" Width="80" Click="Export_Click"/>
            </StackPanel>
        </Border>

        <!-- ── Report body ───────────────────────────────────────────────── -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto">
            <StackPanel x:Name="ReportPanel" Margin="40,24,40,24" MaxWidth="600">

                <!-- Header -->
                <TextBlock x:Name="TbTitle"
                           Text="Income and Expenses Report"
                           FontSize="16" FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,4"/>
                <TextBlock x:Name="TbPeriod"
                           FontSize="13"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

                <!-- Income section -->
                <TextBlock Text="Income"
                           FontSize="13" FontWeight="Bold"
                           Margin="0,0,0,4"/>
                <ItemsControl x:Name="IncomeList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Name}" Margin="12,0,0,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding AmountDisplay}"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Total Income -->
                <Grid Margin="0,4,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Total Income"
                               FontWeight="SemiBold" Margin="0,0,0,0"/>
                    <TextBlock x:Name="TbTotalIncome" Grid.Column="1"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Right"/>
                </Grid>

                <Separator Margin="0,0,0,12"/>

                <!-- Expense section -->
                <TextBlock Text="Expenses"
                           FontSize="13" FontWeight="Bold"
                           Margin="0,0,0,4"/>
                <ItemsControl x:Name="ExpenseList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Name}" Margin="12,0,0,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding AmountDisplay}"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Total Expenses -->
                <Grid Margin="0,4,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Total Expenses"
                               FontWeight="SemiBold"/>
                    <TextBlock x:Name="TbTotalExpenses" Grid.Column="1"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Right"/>
                </Grid>

                <Separator Margin="0,0,0,8"/>

                <!-- Excess income over expenses -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Excess income over expenses"
                               FontWeight="Bold"/>
                    <Border Grid.Column="1"
                            BorderBrush="Black" BorderThickness="0,0,0,2"
                            HorizontalAlignment="Right">
                        <TextBlock x:Name="TbExcess"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Right"/>
                    </Border>
                </Grid>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
