<Window x:Class="FinanceApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DesktopFinance" Height="600" Width="900" MinWidth="400" MinHeight="300"
        Icon="Assets/AppIcon.ico"
        Closing="MainWindow_Closing">

    <Window.Resources>
        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,0,4,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#666666"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#CC0000"/>
                    <Setter Property="Background" Value="#FFDDDD"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel>

        <!-- Menu bar -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Import QFX Data" Click="ImportQfx_Click"/>
                <MenuItem Header="_Export…" Click="ExportTransactions_Click"/>
                <Separator/>
                <MenuItem Header="_Create Backup"  Click="CreateBackup_Click"/>
                <MenuItem Header="_Restore Backup" Click="RestoreBackup_Click"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Undo"   Command="Undo"/>
                <MenuItem Header="_Redo"   Command="Redo"/>
                <Separator/>
                <MenuItem Header="Cu_t"    Command="Cut"/>
                <MenuItem Header="_Copy"   Command="Copy"/>
                <MenuItem Header="_Paste"  Command="Paste"/>
                <MenuItem Header="_Delete" Command="Delete"/>
                <Separator/>
                <MenuItem Header="Select _All" Command="SelectAll"/>
            </MenuItem>
            <MenuItem Header="_Accounts">
                <MenuItem Header="_New Account"       Click="NewAccount_Click"/>
                <MenuItem Header="_Edit Account"      Click="EditAccount_Click"/>
                <Separator/>
                <MenuItem Header="_Bank Statement"    Click="BankStatement_Click"/>
                <MenuItem Header="_Credit Card Statement" Click="CreditCardStatement_Click"/>
                <MenuItem Header="_Other Account Statement" Click="OtherAccountStatement_Click"/>
                <MenuItem Header="Other _Liability Statement" Click="OtherLiabilityStatement_Click"/>
                <MenuItem Header="_Loan Statement"   Click="LoanStatement_Click"/>
            </MenuItem>
            <MenuItem Header="_Category">
                <MenuItem Header="_New Category"  Click="NewCategory_Click"/>
                <MenuItem Header="_Edit Category" Click="EditCategory_Click"/>
                <Separator/>
                <MenuItem Header="Enter _Budget"  Click="EnterBudget_Click"/>
            </MenuItem>
            <MenuItem Header="_Investment">
                <MenuItem Header="_Add Securities"       Click="AddSecurities_Click"/>
                <MenuItem Header="_Add Quotes"           Click="AddQuotes_Click"/>
                <Separator/>
                <MenuItem Header="_Investment Statement" Click="InvestmentStatement_Click"/>
                <MenuItem Header="_Portfolio Statement"  Click="PortfolioStatement_Click"/>
                <Separator/>
                <MenuItem Header="_Stock Split"          Click="StockSplit_Click"/>
            </MenuItem>
            <MenuItem Header="_Recurring">
                <MenuItem Header="_Recurring Payment" Click="RecurringPayment_Click"/>
                <MenuItem Header="_Recurring Receipt" Click="RecurringReceipt_Click"/>
                <MenuItem Header="_View Recurring"    Click="ViewRecurring_Click"/>
            </MenuItem>
            <MenuItem Header="_Reports">
                <MenuItem Header="_Income and Expenses"  Click="IncomeExpenses_Click"/>
                <MenuItem Header="_Budget vs Actual"     Click="BudgetActual_Click"/>
                <MenuItem Header="_Net Worth Statement"  Click="NetWorthStatement_Click"/>
                <MenuItem Header="_Cash Flow Statement"  Click="CashFlowStatement_Click"/>
                <MenuItem Header="_Drilldown Category"   Click="DrilldownCategory_Click"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <!-- Toolbar -->
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button Click="ImportQfx_Click"     ToolTip="Import QFX Data">
                    <Image Source="Assets/Toolbar/ImportQfx.png"     Width="24" Height="24"/>
                </Button>
                <Separator/>
                <Button Click="NewAccount_Click"    ToolTip="New Account">
                    <Image Source="Assets/Toolbar/NewAccount.png"    Width="24" Height="24"/>
                </Button>
                <Button Click="EditAccount_Click"   ToolTip="Edit Account">
                    <Image Source="Assets/Toolbar/EditAccount.png"   Width="24" Height="24"/>
                </Button>
                <Separator/>
                <Button Click="NewCategory_Click"   ToolTip="New Category">
                    <Image Source="Assets/Toolbar/NewCategory.png"   Width="24" Height="24"/>
                </Button>
                <Button Click="EditCategory_Click"  ToolTip="Edit Category">
                    <Image Source="Assets/Toolbar/EditCategory.png"  Width="24" Height="24"/>
                </Button>
                <Button Click="EnterBudget_Click"   ToolTip="Enter Budget">
                    <Image Source="Assets/Toolbar/EnterBudget.png"   Width="24" Height="24"/>
                </Button>
                <Separator/>
                <Button Click="AddSecurities_Click" ToolTip="Add Securities">
                    <Image Source="Assets/Toolbar/AddSecurities.png" Width="24" Height="24"/>
                </Button>
                <Button Click="AddQuotes_Click"     ToolTip="Add Quotes">
                    <Image Source="Assets/Toolbar/AddQuotes.png"     Width="24" Height="24"/>
                </Button>
            </ToolBar>
        </ToolBarTray>

        <!-- Status bar — must appear before the fill Grid in DockPanel order -->
        <StatusBar DockPanel.Dock="Bottom"
                   Background="#F0F0F0"
                   BorderBrush="#CCCCCC"
                   BorderThickness="0,1,0,0">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Ready" Margin="4,0"/>
            </StatusBarItem>
        </StatusBar>

        <!-- Main content area -->
        <Grid>
            <Grid.ColumnDefinitions>
                <!-- Fixed column for the always-visible toggle button -->
                <ColumnDefinition Width="22"/>
                <!-- Collapsible left pane; MinWidth prevents accidental splitter collapse -->
                <ColumnDefinition x:Name="LeftColumn" Width="200" MinWidth="30"/>
                <!-- GridSplitter -->
                <ColumnDefinition Width="4"/>
                <!-- Right pane -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Toggle button: always visible, outside the collapsible column -->
            <Button Grid.Column="0"
                    x:Name="ToggleBtn"
                    Content="&#9664;"
                    Click="ToggleLeftPane_Click"
                    VerticalAlignment="Top"
                    Margin="2,12,2,0"
                    Height="26"
                    FontSize="9"
                    Background="#888888"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    ToolTip="Collapse / expand the navigation pane"/>

            <!-- Left pane -->
            <Border Grid.Column="1"
                    Background="#F5F5F5"
                    BorderBrush="#CCCCCC"
                    BorderThickness="0,0,0,0"
                    ClipToBounds="True">
                <DockPanel>
                    <Border DockPanel.Dock="Top"
                            Background="#E0E0E0"
                            BorderBrush="#CCCCCC"
                            BorderThickness="0,0,0,1"
                            Padding="8,5">
                        <TextBlock Text="Navigation"
                                   FontWeight="SemiBold"
                                   Foreground="#333333"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <!-- Left pane content: account navigation tree -->
                    <TreeView x:Name="NavTree"
                              BorderThickness="0"
                              Background="Transparent"/>
                </DockPanel>
            </Border>

            <!-- GridSplitter -->
            <GridSplitter Grid.Column="2"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="#CCCCCC"
                          ResizeBehavior="PreviousAndNext"/>

            <!-- Right pane: TabControl -->
            <TabControl Grid.Column="3"
                        x:Name="MainTabControl"
                        Background="White"
                        SelectionChanged="MainTabControl_SelectionChanged">
                <TabItem Header="Home" x:Name="HomeTab">
                    <Grid x:Name="HomeTabContent"/>
                </TabItem>
            </TabControl>

        </Grid>
    </DockPanel>
</Window>
