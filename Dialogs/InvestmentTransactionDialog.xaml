<Window x:Class="FinanceApp.Dialogs.InvestmentTransactionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Investment Transaction"
        Height="330" Width="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="22,16,22,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="90"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock  Grid.Row="0"  Grid.Column="0" Text="Date:"     VerticalAlignment="Center"/>
        <DatePicker Grid.Row="0"  Grid.Column="1" x:Name="DpDate"/>

        <TextBlock Grid.Row="2"  Grid.Column="0" Text="Check No:" VerticalAlignment="Center"/>
        <TextBox   Grid.Row="2"  Grid.Column="1" x:Name="TxtCheckNo"/>

        <TextBlock Grid.Row="4"  Grid.Column="0" Text="Name:"     VerticalAlignment="Center"/>
        <TextBox   Grid.Row="4"  Grid.Column="1" x:Name="TxtName"/>

        <TextBlock Grid.Row="6"  Grid.Column="0" Text="Category:" VerticalAlignment="Center"/>
        <ComboBox  Grid.Row="6"  Grid.Column="1" x:Name="CbCategory" IsEditable="False"/>

        <TextBlock Grid.Row="8"  Grid.Column="0" Text="Type:"     VerticalAlignment="Center"/>
        <ComboBox  Grid.Row="8"  Grid.Column="1" x:Name="CbType"  IsEditable="False">
            <ComboBoxItem Content="Deposit"/>
            <ComboBoxItem Content="Payment"/>
        </ComboBox>

        <TextBlock Grid.Row="10" Grid.Column="0" Text="Amount:"   VerticalAlignment="Center"/>
        <TextBox   Grid.Row="10" Grid.Column="1" x:Name="TxtAmount"/>

        <TextBlock Grid.Row="12" Grid.Column="0" Text="Memo:"     VerticalAlignment="Center"/>
        <TextBox   Grid.Row="12" Grid.Column="1" x:Name="TxtMemo"/>

        <StackPanel Grid.Row="14" Grid.ColumnSpan="2"
                    Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Save"   Width="70" IsDefault="True" Margin="0,0,8,0" Click="Save_Click"/>
            <Button Content="Cancel" Width="70" IsCancel="True"  Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
