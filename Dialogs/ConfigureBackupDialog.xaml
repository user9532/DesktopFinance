<Window x:Class="FinanceApp.Dialogs.ConfigureBackupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configure Backup"
        Height="240" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="22,16,22,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <CheckBox Grid.Row="0" x:Name="ChkBackupOnClose"
                   Content="Backup upon closing"
                   VerticalAlignment="Center"
                   Checked="ChkBackupOnClose_CheckedChanged"
                   Unchecked="ChkBackupOnClose_CheckedChanged"/>

        <Button   Grid.Row="2" x:Name="BtnBackupFolder"
                   Content="Backup Folder" Width="120" HorizontalAlignment="Left"
                   IsEnabled="False" Click="BtnBackupFolder_Click"/>

        <TextBox  Grid.Row="4" x:Name="TxtBackupFolder"
                   IsReadOnly="True"/>

        <Button   Grid.Row="6" x:Name="BtnBackupNow"
                   Content="Backup Now" Width="120" HorizontalAlignment="Left"
                   Click="BtnBackupNow_Click"/>

        <StackPanel Grid.Row="8" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="OK"     Width="70" IsDefault="True" Margin="0,0,8,0" Click="Ok_Click"/>
            <Button Content="Cancel" Width="70" IsCancel="True"  Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
