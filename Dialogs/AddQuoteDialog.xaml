<Window x:Class="FinanceApp.Dialogs.AddQuoteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Quote"
        Height="240" Width="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="22,16,22,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="110"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Symbol:"
                   VerticalAlignment="Center"/>
        <ComboBox  Grid.Row="0" Grid.Column="1" x:Name="CbSymbol"
                   IsEditable="False"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Date:"
                   VerticalAlignment="Center"/>
        <DatePicker Grid.Row="2" Grid.Column="1" x:Name="DpDate"
                    DisplayDateEnd="{x:Static system:DateTime.Today}"
                    xmlns:system="clr-namespace:System;assembly=mscorlib"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Price:"
                   VerticalAlignment="Center"/>
        <TextBox   Grid.Row="4" Grid.Column="1" x:Name="TxtPrice"/>

        <StackPanel Grid.Row="6" Grid.ColumnSpan="2"
                    Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Import History" Width="110" Margin="0,0,8,0" Click="ImportHistory_Click"/>
            <Button Content="Save"   Width="70" IsDefault="True" Margin="0,0,8,0" Click="Save_Click"/>
            <Button Content="Cancel" Width="70" IsCancel="True"  Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
