<Window x:Class="FinanceApp.Dialogs.StockSplitDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stock Split" Height="220" Width="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Select Stock -->
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Select Stock"
                   VerticalAlignment="Center" Margin="0,0,8,8"/>
        <ComboBox  Grid.Row="0" Grid.Column="1" x:Name="CbSymbol"
                   Margin="0,0,0,8"/>

        <!-- Date of Split -->
        <TextBlock Grid.Row="1" Grid.Column="0" Text="Date of Split"
                   VerticalAlignment="Center" Margin="0,0,8,8"/>
        <DatePicker Grid.Row="1" Grid.Column="1" x:Name="DpSplitDate"
                    Margin="0,0,0,8"/>

        <!-- Split Ratio -->
        <TextBlock Grid.Row="2" Grid.Column="0" Text="Split Ratio"
                   VerticalAlignment="Center" Margin="0,0,8,0"/>
        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
            <TextBox x:Name="TbX" Width="50" VerticalAlignment="Center"/>
            <TextBlock Text=" for " VerticalAlignment="Center"/>
            <TextBox x:Name="TbY" Width="50" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                    Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Save"   Width="70" Margin="0,0,8,0" Click="Save_Click"/>
            <Button Content="Cancel" Width="70" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
