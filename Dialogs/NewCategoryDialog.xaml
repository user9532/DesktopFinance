<Window x:Class="FinanceApp.Dialogs.NewCategoryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New Category"
        Height="210" Width="320"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="22,16,22,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="110"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Category type -->
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Category type:"
                   VerticalAlignment="Center"/>
        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
            <RadioButton x:Name="RbIncome"  Content="Income"  IsChecked="True" Margin="0,0,14,0"/>
            <RadioButton x:Name="RbExpense" Content="Expense"/>
        </StackPanel>

        <!-- Separator -->
        <Separator Grid.Row="2" Grid.ColumnSpan="2"/>

        <!-- Category name -->
        <TextBlock Grid.Row="4" Grid.Column="0" Text="Category name:"
                   VerticalAlignment="Center"/>
        <TextBox   Grid.Row="4" Grid.Column="1" x:Name="TxtCategoryName"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="8" Grid.ColumnSpan="2"
                    Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Save"   Width="80" IsDefault="True" Margin="0,0,8,0" Click="Save_Click"/>
            <Button Content="Cancel" Width="80" IsCancel="True"  Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
