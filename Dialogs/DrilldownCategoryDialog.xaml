<Window x:Class="FinanceApp.Dialogs.DrilldownCategoryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Drilldown Category"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <StackPanel Margin="20,16,20,16">

        <TextBlock Text="Select Category:" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <ComboBox x:Name="CbCategory" Width="280" Margin="0,0,0,16"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel"   Width="80" IsCancel="True" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button x:Name="BtnContinue" Content="Continue" Width="80" IsDefault="True"
                    IsEnabled="False" Click="Continue_Click"/>
        </StackPanel>

    </StackPanel>
</Window>
