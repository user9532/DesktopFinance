<Window x:Class="FinanceApp.Dialogs.InvestmentTradeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:system="clr-namespace:System;assembly=mscorlib"
        Title="Investment Trade"
        Height="320" Width="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="22,16,22,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="90"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock  Grid.Row="0"  Grid.Column="0" Text="Date:"       VerticalAlignment="Center"/>
        <DatePicker Grid.Row="0"  Grid.Column="1" x:Name="DpDate"/>

        <TextBlock Grid.Row="2"  Grid.Column="0" Text="Action:"     VerticalAlignment="Center"/>
        <ComboBox  Grid.Row="2"  Grid.Column="1" x:Name="CbAction"  IsEditable="False">
            <ComboBoxItem Content="Buy"/>
            <ComboBoxItem Content="Sell"/>
        </ComboBox>

        <TextBlock Grid.Row="4"  Grid.Column="0" Text="Securities:"  VerticalAlignment="Center"/>
        <ComboBox  Grid.Row="4"  Grid.Column="1" x:Name="CbSymbol"  IsEditable="False"/>

        <TextBlock Grid.Row="6"  Grid.Column="0" Text="Quantity:"    VerticalAlignment="Center"/>
        <TextBox   Grid.Row="6"  Grid.Column="1" x:Name="TxtQuantity"/>

        <TextBlock Grid.Row="8"  Grid.Column="0" Text="Price:"       VerticalAlignment="Center"/>
        <TextBox   Grid.Row="8"  Grid.Column="1" x:Name="TxtPrice"/>

        <TextBlock Grid.Row="10" Grid.Column="0" Text="Commission:"  VerticalAlignment="Center"/>
        <TextBox   Grid.Row="10" Grid.Column="1" x:Name="TxtCommission"/>

        <StackPanel Grid.Row="12" Grid.ColumnSpan="2"
                    Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Save"   Width="70" IsDefault="True" Margin="0,0,8,0" Click="Save_Click"/>
            <Button Content="Cancel" Width="70" IsCancel="True"  Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
