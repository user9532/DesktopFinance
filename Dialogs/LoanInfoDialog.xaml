<Window x:Class="FinanceApp.Dialogs.LoanInfoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Loan Information"
        Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" x:Name="InfoGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Account name:"         Margin="0,4"/>
            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtAccountName"      Margin="0,4"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Financial institution:" Margin="0,4"/>
            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtInstitution"       Margin="0,4"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Loan start date:"      Margin="0,4"/>
            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TxtStartDate"        Margin="0,4"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Original principal:"   Margin="0,4"/>
            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="TxtPrincipal"        Margin="0,4"/>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Interest rate:"        Margin="0,4"/>
            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="TxtInterest"         Margin="0,4"/>

            <TextBlock Grid.Row="5" Grid.Column="0" Text="Number of months:"     Margin="0,4"/>
            <TextBlock Grid.Row="5" Grid.Column="1" x:Name="TxtTerm"             Margin="0,4"/>

            <TextBlock Grid.Row="6" Grid.Column="0" Text="Escrow:"               Margin="0,4"/>
            <TextBlock Grid.Row="6" Grid.Column="1" x:Name="TxtEscrow"           Margin="0,4"/>

            <TextBlock Grid.Row="7" Grid.Column="0" Text="Monthly payment:"      Margin="0,4"/>
            <TextBlock Grid.Row="7" Grid.Column="1" x:Name="TxtPmt"              Margin="0,4"/>

            <TextBlock Grid.Row="8" Grid.Column="0" Text="First payment date:"   Margin="0,4"/>
            <TextBlock Grid.Row="8" Grid.Column="1" x:Name="TxtFirstPmnt"        Margin="0,4"/>

            <TextBlock Grid.Row="9" Grid.Column="0" Text="Current balance:"      Margin="0,4"/>
            <TextBlock Grid.Row="9" Grid.Column="1" x:Name="TxtCurrBalance"      Margin="0,4"/>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Close" Width="80" IsDefault="True" IsCancel="True" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
