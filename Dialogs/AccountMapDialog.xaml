<Window x:Class="FinanceApp.Dialogs.AccountMapDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Your Account"
        Height="210" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="20,14,20,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap"
                   Text="The following financial institution was not found in the account list. Please select the account it corresponds to:"/>

        <TextBlock Grid.Row="2" x:Name="LblKey"
                   FontWeight="SemiBold" FontStyle="Italic"/>

        <TextBlock Grid.Row="4" Text="Select account:"/>
        <ComboBox  Grid.Row="6" x:Name="CbAccount"/>

        <StackPanel Grid.Row="8" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="OK"     Width="80" IsDefault="True" Margin="0,0,8,0" Click="OK_Click"/>
            <Button Content="Cancel" Width="80" IsCancel="True"  Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
