<Window x:Class="FinanceApp.Dialogs.SplitTransactionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Split Transaction"
        Height="500" Width="640"
        MinHeight="380" MinWidth="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False">
    <Grid Margin="12,10,12,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Original transaction header ────────────────────────────── -->
        <GroupBox Grid.Row="0" Header="Original Transaction" Padding="10,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="4"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="4"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Date:"     FontWeight="SemiBold" Margin="0,0,6,0"/>
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxDate"/>
                <TextBlock Grid.Row="0" Grid.Column="3" Text="Name:"     FontWeight="SemiBold" Margin="0,0,6,0"/>
                <TextBlock Grid.Row="0" Grid.Column="4" x:Name="TxName"/>

                <TextBlock Grid.Row="2" Grid.Column="0" x:Name="TxAmtLabel" FontWeight="SemiBold" Margin="0,0,6,0"/>
                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TxAmount"/>
                <TextBlock Grid.Row="2" Grid.Column="3" Text="Category:" FontWeight="SemiBold" Margin="0,0,6,0"/>
                <TextBlock Grid.Row="2" Grid.Column="4" x:Name="TxCategory"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Memo:"     FontWeight="SemiBold" Margin="0,0,6,0"/>
                <TextBlock Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="4" x:Name="TxMemo"/>
            </Grid>
        </GroupBox>

        <!-- ── Split allocations ──────────────────────────────────────── -->
        <GroupBox Grid.Row="2" Header="Split Allocations" Padding="10,6">
            <DockPanel>

                <!-- Totals + Add button at bottom -->
                <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="70"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="+ Add Split" Padding="8,3" Click="AddSplit_Click"/>

                    <TextBlock Grid.Column="2" Text="Total:"     VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Grid.Column="3" x:Name="TxTotal"  VerticalAlignment="Center" FontWeight="SemiBold"/>

                    <TextBlock Grid.Column="5" Text="Remaining:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Grid.Column="6" x:Name="TxRemaining" VerticalAlignment="Center" FontWeight="SemiBold"/>
                </Grid>

                <!-- Split DataGrid -->
                <DataGrid x:Name="SplitGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserSortColumns="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          AlternatingRowBackground="#FAFAFA"
                          CellEditEnding="SplitGrid_CellEditEnding">
                    <DataGrid.Columns>

                        <!-- Category -->
                        <DataGridTemplateColumn Header="Category" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Category}" Margin="3,1" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox IsEditable="True"
                                              Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}"
                                              Loaded="SplitCategoryCombo_Loaded"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <!-- Amount -->
                        <DataGridTextColumn Header="Amount"
                                            Binding="{Binding Amount, UpdateSourceTrigger=PropertyChanged}"
                                            Width="100"/>

                        <!-- Memo -->
                        <DataGridTextColumn Header="Memo"
                                            Binding="{Binding Memo, UpdateSourceTrigger=PropertyChanged}"
                                            Width="*"/>

                        <!-- Remove -->
                        <DataGridTemplateColumn Width="30" Header="">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="×"
                                            Click="RemoveSplit_Click"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Foreground="#CC0000"
                                            FontSize="14"
                                            FontWeight="Bold"
                                            Cursor="Hand"
                                            ToolTip="Remove split line"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </GroupBox>

        <!-- ── Buttons ────────────────────────────────────────────────── -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Save"   Width="80" IsDefault="True" Margin="0,0,8,0" Click="Save_Click"/>
            <Button Content="Cancel" Width="80" IsCancel="True"  Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
