<Window x:Class="FinanceApp.Dialogs.NewDatabaseDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New Database"
        Width="400" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <StackPanel Margin="24,20,24,24">
        <TextBlock TextWrapping="Wrap"
                   Text="Creating a new database will delete the existing database. Create a backup before you proceed."
                   Margin="0,0,0,16"/>

        <CheckBox x:Name="ChkHaveBackup"
                   Content="I have a backup"
                   Checked="ChkHaveBackup_CheckedChanged"
                   Unchecked="ChkHaveBackup_CheckedChanged"
                   Margin="0,0,0,20"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel"   Width="80" Margin="0,0,8,0" IsCancel="True"/>
            <Button x:Name="BtnContinue" Content="Continue" Width="80"
                    IsEnabled="False" Click="BtnContinue_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
