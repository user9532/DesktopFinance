<Window x:Class="FinanceApp.Dialogs.RecurringDetailDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recurring Transaction Detail"
        Height="500" Width="820"
        MinHeight="400" MinWidth="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False">

    <DockPanel Margin="16,14,16,14">

        <!-- Shared header: NextDue, Frequency, Account -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Next Due Date:" VerticalAlignment="Center"/>
            <DatePicker Grid.Column="2" x:Name="DpNextDue" VerticalAlignment="Center"/>

            <TextBlock Grid.Column="4" Text="Frequency:" VerticalAlignment="Center"/>
            <TextBox   Grid.Column="6" x:Name="TxtFrequency" IsReadOnly="True"
                       Background="#F0F0F0" VerticalAlignment="Center"/>

            <TextBlock Grid.Column="8" Text="Account:" VerticalAlignment="Center"/>
            <ComboBox  Grid.Column="10" x:Name="CbAccount" VerticalAlignment="Center"/>
        </Grid>

        <!-- Column headers for lines -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="PayeeHeader" Text="Payee"    FontWeight="SemiBold"/>
            <TextBlock Grid.Column="2" Text="Amount"   FontWeight="SemiBold"/>
            <TextBlock Grid.Column="4" Text="Category" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="6" Text="Memo"     FontWeight="SemiBold"/>
        </Grid>

        <!-- Scrollable lines -->
        <Border DockPanel.Dock="Top" BorderBrush="#CCCCCC" BorderThickness="1"
                Height="220">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="LinesPanel"/>
            </ScrollViewer>
        </Border>

        <!-- Buttons pinned to bottom -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Post"   Width="80" Margin="0,0,8,0" Click="Post_Click"/>
            <Button Content="Skip"   Width="80" Margin="0,0,8,0" Click="Skip_Click"/>
            <Button Content="Cancel" Width="80" IsCancel="True"/>
        </StackPanel>

        <Rectangle Fill="Transparent"/>
    </DockPanel>
</Window>
