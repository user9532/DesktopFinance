<Window x:Class="FinanceApp.Dialogs.EnterBudgetDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Enter Budget"
        Height="400" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="16,12,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Header: category (left) and year (right) ───────────────── -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Category:" FontWeight="SemiBold" Margin="0,0,0,3"/>
                <ComboBox x:Name="CbCategory"
                          SelectionChanged="CbCategory_SelectionChanged"/>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Year:" FontWeight="SemiBold" Margin="0,0,0,3"/>
                <ComboBox x:Name="CbYear" Width="90"
                          SelectionChanged="CbYear_SelectionChanged"/>
            </StackPanel>
        </Grid>

        <!-- ── Month input grid (4 rows × 3 columns) ──────────────────── -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Row 0 -->
            <StackPanel Grid.Row="0" Grid.Column="0" Margin="4,3">
                <TextBlock Text="January"  FontSize="11" Foreground="#555555"/>
                <TextBox x:Name="M01" Margin="0,2,6,0"/>
            </StackPanel>
            <StackPanel Grid.Row="0" Grid.Column="1" Margin="4,3">
                <TextBlock Text="February" FontSize="11" Foreground="#555555"/>
                <TextBox x:Name="M02" Margin="0,2,6,0"/>
            </StackPanel>
            <StackPanel Grid.Row="0" Grid.Column="2" Margin="4,3">
                <TextBlock Text="March"    FontSize="11" Foreground="#555555"/>
                <TextBox x:Name="M03" Margin="0,2,0,0"/>
            </StackPanel>

            <!-- Row 1 -->
            <StackPanel Grid.Row="1" Grid.Column="0" Margin="4,3">
                <TextBlock Text="April"    FontSize="11" Foreground="#555555"/>
                <TextBox x:Name="M04" Margin="0,2,6,0"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="1" Margin="4,3">
                <TextBlock Text="May"      FontSize="11" Foreground="#555555"/>
                <TextBox x:Name="M05" Margin="0,2,6,0"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="2" Margin="4,3">
                <TextBlock Text="June"     FontSize="11" Foreground="#555555"/>
                <TextBox x:Name="M06" Margin="0,2,0,0"/>
            </StackPanel>

            <!-- Row 2 -->
            <StackPanel Grid.Row="2" Grid.Column="0" Margin="4,3">
                <TextBlock Text="July"      FontSize="11" Foreground="#555555"/>
                <TextBox x:Name="M07" Margin="0,2,6,0"/>
            </StackPanel>
            <StackPanel Grid.Row="2" Grid.Column="1" Margin="4,3">
                <TextBlock Text="August"    FontSize="11" Foreground="#555555"/>
                <TextBox x:Name="M08" Margin="0,2,6,0"/>
            </StackPanel>
            <StackPanel Grid.Row="2" Grid.Column="2" Margin="4,3">
                <TextBlock Text="September" FontSize="11" Foreground="#555555"/>
                <TextBox x:Name="M09" Margin="0,2,0,0"/>
            </StackPanel>

            <!-- Row 3 -->
            <StackPanel Grid.Row="3" Grid.Column="0" Margin="4,3">
                <TextBlock Text="October"  FontSize="11" Foreground="#555555"/>
                <TextBox x:Name="M10" Margin="0,2,6,0"/>
            </StackPanel>
            <StackPanel Grid.Row="3" Grid.Column="1" Margin="4,3">
                <TextBlock Text="November" FontSize="11" Foreground="#555555"/>
                <TextBox x:Name="M11" Margin="0,2,6,0"/>
            </StackPanel>
            <StackPanel Grid.Row="3" Grid.Column="2" Margin="4,3">
                <TextBlock Text="December" FontSize="11" Foreground="#555555"/>
                <TextBox x:Name="M12" Margin="0,2,0,0"/>
            </StackPanel>
        </Grid>

        <!-- ── Buttons ────────────────────────────────────────────────── -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="80" IsCancel="True" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="Save"   Width="80"                 Margin="0,0,8,0" Click="Save_Click"/>
            <Button Content="Close"  Width="80"                                  Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
