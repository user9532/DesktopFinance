<Window x:Class="FinanceApp.Dialogs.LoanPaymentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Loan Payment"
        Height="512" Width="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="22,16,22,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- From Account -->
        <TextBlock Grid.Row="0" Grid.Column="0" Text="From Account:" VerticalAlignment="Center"/>
        <ComboBox  Grid.Row="0" Grid.Column="1" x:Name="CbFromAccount"/>

        <!-- Check No. -->
        <TextBlock Grid.Row="2" Grid.Column="0" Text="Check No.:" VerticalAlignment="Center"/>
        <TextBox   Grid.Row="2" Grid.Column="1" x:Name="TxtCheckNo"/>

        <!-- Payment Date -->
        <TextBlock Grid.Row="4" Grid.Column="0" Text="Payment Date:" VerticalAlignment="Center"/>
        <DatePicker Grid.Row="4" Grid.Column="1" x:Name="DpPaymentDate" SelectedDateChanged="DpPaymentDate_SelectedDateChanged"/>

        <!-- Loan Account -->
        <TextBlock Grid.Row="6" Grid.Column="0" Text="Loan Account:" VerticalAlignment="Center"/>
        <TextBox   Grid.Row="6" Grid.Column="1" x:Name="TxtLoanAccount" IsEnabled="False"/>

        <!-- Description -->
        <TextBlock Grid.Row="8" Grid.Column="0" Text="Description:" VerticalAlignment="Center"/>
        <TextBox   Grid.Row="8" Grid.Column="1" x:Name="TxtDescription" IsEnabled="False"/>

        <!-- Loan Principal -->
        <TextBlock Grid.Row="10" Grid.Column="0" Text="Loan Principal:" VerticalAlignment="Center"/>
        <TextBox   Grid.Row="10" Grid.Column="1" x:Name="TxtPrincipal"/>

        <!-- Interest + Interest Category -->
        <TextBlock Grid.Row="12" Grid.Column="0" Text="Interest:" VerticalAlignment="Center"/>
        <Grid Grid.Row="12" Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="140"/>
            </Grid.ColumnDefinitions>
            <TextBox   Grid.Column="0" x:Name="TxtInterest"/>
            <TextBlock Grid.Column="2" Text="Interest Category:" VerticalAlignment="Center"/>
            <ComboBox  Grid.Column="4" x:Name="CbInterestCategory"/>
        </Grid>

        <!-- Escrow + Escrow Category -->
        <TextBlock Grid.Row="14" Grid.Column="0" Text="Escrow:" VerticalAlignment="Center"/>
        <Grid Grid.Row="14" Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="140"/>
            </Grid.ColumnDefinitions>
            <TextBox   Grid.Column="0" x:Name="TxtEscrow"/>
            <TextBlock Grid.Column="2" Text="Escrow Category:" VerticalAlignment="Center"/>
            <ComboBox  Grid.Column="4" x:Name="CbEscrowCategory"/>
        </Grid>

        <!-- Total -->
        <TextBlock Grid.Row="16" Grid.Column="0" Text="Total:" VerticalAlignment="Center"/>
        <TextBox   Grid.Row="16" Grid.Column="1" x:Name="TxtTotal" IsEnabled="False"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="18" Grid.ColumnSpan="2"
                    Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Post"   Width="80" IsDefault="True" Margin="0,0,8,0" Click="Post_Click"/>
            <Button Content="Cancel" Width="80" IsCancel="True"  Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
