<Window x:Class="FinanceApp.Dialogs.LoanAccountDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New Loan Account"
        Height="362" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="22,16,22,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Account name -->
        <TextBlock Grid.Row="0"  Grid.Column="0" Text="Account name:"           VerticalAlignment="Center"/>
        <TextBox   Grid.Row="0"  Grid.Column="1" x:Name="TxtAccountName"/>

        <!-- Start date -->
        <TextBlock Grid.Row="2"  Grid.Column="0" Text="Account start date:"     VerticalAlignment="Center"/>
        <DatePicker Grid.Row="2" Grid.Column="1" x:Name="DpStartDate"/>

        <!-- Institution -->
        <TextBlock Grid.Row="4"  Grid.Column="0" Text="Financial institution:"  VerticalAlignment="Center"/>
        <TextBox   Grid.Row="4"  Grid.Column="1" x:Name="TxtInstitution"/>

        <!-- Loan amount -->
        <TextBlock Grid.Row="6"  Grid.Column="0" Text="Amount of loan:"         VerticalAlignment="Center"/>
        <TextBox   Grid.Row="6"  Grid.Column="1" x:Name="TxtLoanAmount"/>

        <!-- Number of payments -->
        <TextBlock Grid.Row="8"  Grid.Column="0" Text="Total number of payments:" VerticalAlignment="Center"/>
        <TextBox   Grid.Row="8"  Grid.Column="1" x:Name="TxtNumPayments"/>

        <!-- Interest rate -->
        <TextBlock Grid.Row="10" Grid.Column="0" Text="Interest rate (%):"      VerticalAlignment="Center"/>
        <TextBox   Grid.Row="10" Grid.Column="1" x:Name="TxtInterestRate"/>

        <!-- Escrow -->
        <TextBlock Grid.Row="12" Grid.Column="0" Text="Escrow amount:"          VerticalAlignment="Center"/>
        <TextBox   Grid.Row="12" Grid.Column="1" x:Name="TxtEscrow"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="14" Grid.ColumnSpan="2"
                    Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Save"   Width="80" IsDefault="True" Margin="0,0,8,0" Click="Save_Click"/>
            <Button Content="Cancel" Width="80" IsCancel="True"  Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
