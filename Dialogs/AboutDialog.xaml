<Window x:Class="FinanceApp.Dialogs.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About"
        Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="DesktopFinance"
                   FontSize="18" FontWeight="Bold"/>
        <TextBlock Grid.Row="2" x:Name="TxtVersion" Text="Version 1.0"
                   Margin="0,0,0,10"/>
        <TextBlock Grid.Row="3" TextWrapping="Wrap"
                   Text="An open-source personal finance manager."/>
        <TextBlock Grid.Row="5" TextWrapping="Wrap"
                   Text="Designed by CPA, built with AI."/>

        <TextBlock Grid.Row="7" TextWrapping="Wrap" FontSize="11" Foreground="#666666"
                   Text="Built with .NET 8 / WPF (Windows Presentation Foundation), using SQLite as the local database engine."/>

        <TextBlock Grid.Row="8" Margin="0,10,0,0">
            <Hyperlink NavigateUri="https://www.eworkpaper.com/desktopfinance"
                       RequestNavigate="Website_RequestNavigate">www.eworkpaper.com/desktopfinance</Hyperlink>
        </TextBlock>

        <Button Grid.Row="9" Content="OK" Width="80"
                IsDefault="True" IsCancel="True"
                HorizontalAlignment="Right"
                Margin="0,14,0,0"
                Click="OK_Click"/>
    </Grid>
</Window>
