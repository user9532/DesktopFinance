<Window x:Class="FinanceApp.Dialogs.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About"
        Height="260" Width="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="DesktopFinance"
                   FontSize="18" FontWeight="Bold"/>
        <TextBlock Grid.Row="2" x:Name="TxtVersion" Text="Version 1.0"
                   Margin="0,0,0,10"/>
        <TextBlock Grid.Row="3" TextWrapping="Wrap"
                   Text="A personal finance manager for tracking bank, credit card, investment, and loan accounts, budgets, and reports."/>

        <TextBlock Grid.Row="5" TextWrapping="Wrap" FontSize="11" Foreground="#666666"
                   Text="Built with .NET 8 / WPF (Windows Presentation Foundation), using SQLite as the local database engine."/>

        <Button Grid.Row="7" Content="OK" Width="80"
                IsDefault="True" IsCancel="True"
                HorizontalAlignment="Right"
                Click="OK_Click"/>
    </Grid>
</Window>
